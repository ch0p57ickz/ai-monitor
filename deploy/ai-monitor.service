[Unit]
Description=ai-monitor usage service (loopback JSON API for Codex, Antigravity, OpenRouter)
Documentation=file:/opt/ai-monitor/docs/gx10-runbook.md
After=network-online.target
Wants=network-online.target

# Stop retrying a start that cannot succeed, and say so. With no limit, a unit
# whose ExecStart cannot be executed restarts forever: observed on this host as
# 2141 restarts of status=203/EXEC (an empty /opt/ai-monitor, so no venv and no
# binary) while `systemctl is-enabled` still read "enabled" and `enable --now`
# had returned success. The service still restarts itself automatically; it just
# stops retrying a start that never succeeds. Once the limit trips, the unit
# reports failed, and `systemctl reset-failed ai-monitor` (or waiting out the
# interval) allows a fresh start after the cause is fixed.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
# Dedicated unprivileged account. It owns its own home so the Codex CLI state
# (~/.codex) and the Antigravity CLI caches stay separate from the operator
# account. The default stdio transport spawns `codex app-server` as a child of
# this service, so it inherits this sandbox; only the alternative socket
# transport needs ~/.codex/app-server-control to be reachable.
User=ai-monitor
Group=ai-monitor
WorkingDirectory=/opt/ai-monitor

# Credentials live in a 0640 config file owned by root and readable by the
# service account's group, never in this unit, the environment, or a
# world-readable path.
ExecStart=/opt/ai-monitor/venv/bin/ai-monitor --config /etc/ai-monitor/config.json

Restart=always
RestartSec=5

# Persistent state (SQLite in WAL mode) survives restarts.
Environment=AI_MONITOR_DATA_DIR=/var/lib/ai-monitor
StateDirectory=ai-monitor
StateDirectoryMode=0700

# Hardening. The service only needs its own home, its data directory, and
# outbound network access to the providers.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
# ProtectSystem=strict mounts the entire hierarchy read-only, $HOME included, so
# the service account's own home must be listed explicitly or the bundled Codex
# CLI cannot write ~/.codex. Verified on 2026-10-19: `codex app-server` dies
# outright when $HOME is read-only, and fails with "codex account authentication
# required" when $HOME has no ~/.codex/auth.json. ReadWritePaths= requires the
# path to exist, so create the account's home (`useradd -m`) before enabling.
ReadWritePaths=/var/lib/ai-monitor
ReadWritePaths=/home/ai-monitor
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
